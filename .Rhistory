# Create age groups
hantavirus_data <- hantavirus_data %>%
mutate(
Age = as.numeric(Age),
age_group = cut(Age,
breaks = c(0, 18, 35, 50, 65, Inf),
labels = c("0–18", "19–35", "36–50", "51–65", "65+"),
right = TRUE)
)
